{
  "expo": {
    "name": "uninest_mobile",
    "slug": "uninest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpg",
    "scheme": "uninestmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.jpg",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "UniNest cần truy cập thư viện ảnh để bạn upload hình phòng trọ.",
        "NSCameraUsageDescription": "UniNest cần truy cập camera để bạn chụp ảnh phòng trọ.",
        "NSLocationWhenInUseUsageDescription": "UniNest cần vị trí của bạn để hiển thị khoảng cách tới phòng trọ trên bản đồ."
      }
    },
    "android": {
      "package": "com.uninest.mobile",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo.jpg"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "UniNest cần truy cập thư viện ảnh để bạn upload hình phòng trọ.",
          "cameraPermission": "UniNest cần truy cập camera để bạn chụp ảnh phòng trọ."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.jpg",
          "imageWidth": 120,
          "android": {
            "image": "./assets/images/logo.jpg",
            "imageWidth": 120
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UniNest cần vị trí của bạn để hiển thị khoảng cách tới phòng trọ trên bản đồ."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "78e23260-eb67-4efb-969e-93e1ea91d494"
      }
    },
    "owner": "viethq2004s-team"
  }
}
